class Solution {
public:
    int numberOfSubstrings(string s) {
        int last[] = {-1,-1,-1};
        int n = s.size();
        int ans = 0;

        for( int i = 0 ; i < n ; i++ ){
            last[s[i] - 'a'] = i;

            if( last[0]!=-1 && last[1]!=-1 && last[2]!=-1 ){
                ans += 1 + min({last[0],last[1],last[2]});
            }
        }

        return ans;
    }
};
