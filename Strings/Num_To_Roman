class Solution {
public:
    string intToRoman(int num) {
       vector<int> value = {
        1000,900,500,400,
        100,90,50,40,
        10,9,5,4,1
       };
       vector<string> ValToString = {
        "M","CM","D","CD",
        "C","XC","L","XL",
        "X","IX","V","IV","I"
       };
       string res = "";

       for(int i=0 ; i<value.size() ; i++){
            while(num >= value[i]){
                res += ValToString[i];
                num -= value[i];
            }
       }

       return res;
    }
};
